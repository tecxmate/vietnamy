{
  "name": "vnme-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "prebuild": "npm run validate:curriculum",
    "build": "npx vite build && cd server && npm install",
    "start": "node server/server.js",
    "lint": "eslint .",
    "curriculum:build": "node scripts/build-unified-db.js && npm run validate:curriculum && npm run content:build",
    "curriculum:export": "npm run validate:curriculum && node scripts/export-sqlite.js",
    "validate:curriculum": "node scripts/validate-curriculum.js",
    "validate:content": "node scripts/validate-content.mjs",
    "content:build": "node scripts/build-canonical.mjs",
    "tts:migrate:r2": "node scripts/migrate-tts-supabase-to-r2.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@supabase/supabase-js": "^2.99.3",
    "@vercel/blob": "^2.4.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.575.0",
    "opencc-js": "^1.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.3",
    "snd-lib": "^1.2.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "xlsx": "^0.18.5"
  }
}
