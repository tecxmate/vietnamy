{
  "name": "vnme-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "prebuild": "npm run validate:curriculum && npm run validate:spell",
    "build": "npx vite build && cd server && npm install",
    "start": "node server/server.js",
    "lint": "eslint .",
    "curriculum:build": "node scripts/build-unified-db.js && npm run validate:curriculum && npm run content:build",
    "curriculum:export": "npm run validate:curriculum && node scripts/export-sqlite.js",
    "validate:curriculum": "node scripts/validate-curriculum.js",
    "validate:content": "node scripts/validate-content.mjs",
    "content:build": "node scripts/build-canonical.mjs && node scripts/build-roadmap-seed.mjs",
    "db:apply:neon": "psql \"$DATABASE_URL\" -f neon/migrations/202606110001_backend_foundation.sql",
    "db:check:neon-parity": "node scripts/check-neon-parity.mjs",
    "db:export:supabase": "node scripts/export-supabase-neon-sql.mjs",
    "ops:export:postgres": "node scripts/export-app-ops-postgres.mjs",
    "feedback:queue": "node scripts/feedback-agent-pipeline.mjs list",
    "feedback:claim": "node scripts/feedback-agent-pipeline.mjs claim",
    "feedback:mark": "node scripts/feedback-agent-pipeline.mjs mark",
    "feedback:pending-approval": "node scripts/feedback-agent-pipeline.mjs pending-approval",
    "tts:migrate:r2": "node scripts/migrate-tts-supabase-to-r2.mjs",
    "validate:spell": "node scripts/validate-spell-lexicon.mjs",
    "spell:lexicon": "node scripts/gen-vn-syllables.mjs",
    "spell:audio:list": "node scripts/gen-audio-list.mjs",
    "spell:audio:upload": "node scripts/upload-spell-audio-r2.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@auth/express": "^0.12.2",
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@neondatabase/serverless": "^1.0.2",
    "@supabase/supabase-js": "^2.99.3",
    "@vercel/blob": "^2.4.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.575.0",
    "opencc-js": "^1.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.3",
    "snd-lib": "^1.2.4",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.61.0",
    "read-excel-file": "^9.2.0",
    "vite": "^8.0.16"
  }
}
