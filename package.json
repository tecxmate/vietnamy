{
  "name": "vnme-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "prebuild": "npm run validate:curriculum",
    "build": "npx vite build && cd server && npm install",
    "start": "node server/server.js",
    "lint": "eslint .",
    "curriculum:build": "node scripts/build-unified-db.js && npm run validate:curriculum",
    "curriculum:export": "npm run validate:curriculum && node scripts/export-sqlite.js",
    "validate:curriculum": "node scripts/validate-curriculum.js",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:mobile": "VITE_API_BASE_URL=https://vietnamy.tecxmate.com npm run cap:sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npm run build && npx cap run ios",
    "cap:run:android": "npm run build && npx cap run android",
    "cap:android:debug": "VITE_API_BASE_URL=https://vietnamy.tecxmate.com npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@supabase/supabase-js": "^2.99.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.575.0",
    "opencc-js": "^1.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.3",
    "snd-lib": "^1.2.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "xlsx": "^0.18.5"
  }
}
