VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: server-side operational store. Use sqlite, supabase, or neon.
# Keep service-role keys server-side only; never expose them in VITE_* vars.
OPS_STORE_PROVIDER=sqlite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Neon migration target. Supabase remains primary unless the
# client/backend provider flags below are changed.
DATABASE_URL=
NEON_DATABASE_URL=
VITE_CLOUD_SYNC_PROVIDER=supabase
VITE_CLOUD_SYNC_DUAL_WRITE=false

# Optional: Auth.js scaffold. Leave AUTH_PROVIDER=supabase until cutover.
AUTH_PROVIDER=supabase
AUTH_SECRET=replace-with-random-secret
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: Azure Speech TTS.
# If these are blank/missing, /api/tts falls back to Google Translate TTS.
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=your-azure-region-here
AZURE_TTS_VOICE_NORTH=vi-VN-NamMinhNeural
AZURE_TTS_VOICE_SOUTH=vi-VN-HoaiMyNeural

# Optional: transactional email through Resend.
# EMAIL_FROM should use a verified Resend sender in production.
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM="Vietnamy <hello@your-domain.com>"
SUPPORT_EMAIL=ceo@tecxmate.com
PUBLIC_BASE_URL=https://vietnamy.app
# MAIL_ADMIN_TOKEN is the master credential: it gates /api/admin/*,
# /api/push/* and /api/messages/*, i.e. reading feedback and sending email and
# push to the whole user base. Unset means all of them deny, so set it in
# production. Present it as `Authorization: Bearer <token>`, `x-admin-token`,
# `x-mail-admin-token`, or `?token=`.
MAIL_ADMIN_TOKEN=change-me-to-random-secret
# Local development only: with MAIL_ADMIN_TOKEN unset, allow requests whose TCP
# peer address is loopback through the admin gate. It is decided from the socket,
# not from X-Forwarded-For, so it cannot be claimed by a header — but a reverse
# proxy on the same host also connects from loopback, so never set this on a
# deployed host. It does not apply to uploads at all.
MAIL_ADMIN_ALLOW_LOCAL=false

# MASCOT_UPLOAD_TOKEN gates /api/mascot-upload and NOTHING else. It exists so
# the person uploading mascot art holds a credential that cannot be replayed
# against the admin routes above; the server refuses to serve the upload route
# if this is set to the same value as MAIL_ADMIN_TOKEN. Unset means deny, with
# no localhost exception — set it in .env.local for development too.
MASCOT_UPLOAD_TOKEN=change-me-to-a-different-random-secret

# Optional: Cloudflare R2 TTS cache.
# R2_ENDPOINT should usually be https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL should be your public bucket URL or custom domain.
TTS_STORAGE_PROVIDER=r2
TTS_BUCKET=tts-cache
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://tts.your-domain.com

# Optional: mascot/art uploads to R2 instead of Vercel Blob.
MASCOT_STORAGE_PROVIDER=blob
R2_MASCOT_BUCKET=app-assets
