VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: server-side operational store. Use sqlite, supabase, or neon.
# Keep service-role keys server-side only; never expose them in VITE_* vars.
OPS_STORE_PROVIDER=sqlite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Neon migration target. Supabase remains primary unless the
# client/backend provider flags below are changed.
DATABASE_URL=
NEON_DATABASE_URL=
VITE_CLOUD_SYNC_PROVIDER=supabase
VITE_CLOUD_SYNC_DUAL_WRITE=false

# Optional: Auth.js scaffold. Leave AUTH_PROVIDER=supabase until cutover.
AUTH_PROVIDER=supabase
AUTH_SECRET=replace-with-random-secret
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: Azure Speech TTS.
# If these are blank/missing, /api/tts falls back to Google Translate TTS.
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=your-azure-region-here
AZURE_TTS_VOICE_NORTH=vi-VN-NamMinhNeural
AZURE_TTS_VOICE_SOUTH=vi-VN-HoaiMyNeural

# Optional: transactional email through Resend.
# EMAIL_FROM should use a verified Resend sender in production.
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM="Vietnamy <hello@your-domain.com>"
SUPPORT_EMAIL=ceo@tecxmate.com
PUBLIC_BASE_URL=https://vietnamy.app
MAIL_ADMIN_TOKEN=change-me-to-random-secret

# Optional: Cloudflare R2 TTS cache.
# R2_ENDPOINT should usually be https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL should be your public bucket URL or custom domain.
TTS_STORAGE_PROVIDER=r2
TTS_BUCKET=tts-cache
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://tts.your-domain.com

# Optional: mascot/art uploads to R2 instead of Vercel Blob.
MASCOT_STORAGE_PROVIDER=blob
R2_MASCOT_BUCKET=app-assets

# ─── AI tutor (POST /api/tutor) ─────────────────────────────────────────────
# This is the tutor the Flutter app actually calls. The NestJS repo has another
# one that nothing calls — see docs/ROLE-OF-THIS-REPO.md before fixing either.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Identity. Must be the SAME value as JWT_SECRET in the NestJS environment —
# that is what signs the member access tokens this server verifies. Without it
# every caller is anonymous: the boot log prints "Tutor guardrails: auth=off".
JWT_SECRET=

# Where the tutor's SQLite store lives (free-tier counters AND usage events).
# MUST point at a persistent volume in production — left at the default it
# lands inside the container and a redeploy resets every allowance and erases
# the metrics. Same caveat as tone_samples.db.
TUTOR_USAGE_DB_PATH=

# Guardrails. free-per-day is the paywall; the other two bound spend for
# everyone, signed in or not.
TUTOR_FREE_MESSAGES_PER_DAY=30
TUTOR_MAX_PER_IP_PER_HOUR=60
TUTOR_GLOBAL_DAILY_MAX=5000

# The tightening switch. Leave false until app builds that send the member JWT
# have replaced the ones that do not — flipping it early breaks the tutor for
# every phone still running an older build. The metrics report's "carried no
# verifiable token" share is how you know when that has happened.
TUTOR_REQUIRE_AUTH=false

# Metering day boundary, in hours from UTC. 7 = midnight in Vietnam.
TUTOR_DAY_UTC_OFFSET_HOURS=7

# How long usage events are kept, in days. Longer than the allowance counters
# because retention cannot be measured in a window shorter than the return
# interval you are looking for.
TUTOR_METRICS_RETAIN_DAYS=90

# Optional: your current OpenAI prices, so `npm run tutor:metrics` can turn
# tokens into dollars. Left blank it reports tokens only, which is the honest
# default — a price hardcoded in the repo would go stale and quietly lie.
TUTOR_COST_USD_PER_MTOK_IN=
TUTOR_COST_USD_PER_MTOK_OUT=

# Reading the numbers: `npm run tutor:metrics`. It authenticates with
# MAIL_ADMIN_TOKEN above (the same operator credential /api/push/stats uses)
# and defaults to localhost; TUTOR_METRICS_URL points it at production.
TUTOR_METRICS_URL=
