{
  "modules": [
    {
      "module_id": "lesson_svo_pilot",
      "lesson_id": "lesson_svo_pilot",
      "unit_id": "phase_1_first_words",
      "title_vi": "Chủ ngữ + Động từ + Tân ngữ",
      "title_en": "Subject + Verb + Object",
      "est_minutes": 6,
      "cefr": "A1.2",
      "difficulty": 2,
      "learn": [
        {
          "type": "objective",
          "can_do": [
            "Say what you are doing to something — Tôi ăn cơm",
            "Order food and drink without pointing",
            "Recognise the pattern in 3 everyday verbs"
          ],
          "already_know": {
            "title_vi": "Chủ ngữ + Động từ",
            "note": "Subject + Verb — you already met this. This module adds the object."
          }
        },
        {
          "type": "pattern",
          "slots": [
            { "label": "SUBJECT", "color": "navy" },
            { "label": "VERB", "color": "pink" },
            { "label": "OBJECT", "color": "teal" }
          ],
          "example": { "vi": "Tôi ăn cơm", "en": "I eat rice", "slot_map": ["Tôi", "ăn", "cơm"] },
          "note": "Add an object the same way as in English. And the verb never changes — ăn is always ăn.",
          "examples": [
            { "vi": "Anh ấy uống nước", "en": "He drinks water" },
            { "vi": "Chúng tôi đọc sách", "en": "We read a book" }
          ]
        },
        {
          "type": "insight",
          "kicker": "The question everyone asks",
          "headline": "Vietnamese is SVO — like English",
          "body": "Sentences are Subject + Verb + Object, exactly like English. That is why this pattern feels free: you already have the instinct."
        },
        {
          "type": "vocab",
          "words": [
            { "vi": "ăn", "en": "to eat", "pos": "verb", "example": { "vi": "ăn cơm", "en": "eat rice" } },
            { "vi": "uống", "en": "to drink", "pos": "verb", "note": "Takes a liquid object directly — no preposition.", "example": { "vi": "uống nước", "en": "drink water" } },
            { "vi": "đọc", "en": "to read", "pos": "verb", "example": { "vi": "đọc sách", "en": "read a book" } },
            { "vi": "cơm", "en": "rice (cooked)", "pos": "noun", "example": { "vi": "ăn cơm", "en": "eat rice" } }
          ]
        }
      ],
      "practice": [
        {
          "id": "svo_p1",
          "item_id": "svo_toi_an_com",
          "exercise_type": "mcq_translate_to_en",
          "prompt": {
            "source_text_vi": "Tôi ăn cơm",
            "choices_en": ["I eat rice", "I drink water", "I read a book", "I listen to music"],
            "answer_en": "I eat rice"
          }
        },
        {
          "id": "svo_p2",
          "item_id": "svo_anh_ay_uong_nuoc",
          "exercise_type": "mcq_translate_to_en",
          "prompt": {
            "source_text_vi": "Anh ấy uống nước",
            "choices_en": ["He drinks water", "He eats rice", "We read a book", "They listen to music"],
            "answer_en": "He drinks water"
          }
        },
        {
          "id": "svo_p3",
          "item_id": "svo_chung_toi_doc_sach",
          "exercise_type": "listen_choose",
          "prompt": {
            "audio_text": "Chúng tôi đọc sách",
            "choices_vi": ["Chúng tôi đọc sách", "Chúng tôi ăn cơm", "Anh ấy uống nước", "Tôi đọc sách"],
            "answer_vi": "Chúng tôi đọc sách"
          }
        },
        {
          "id": "svo_p4",
          "item_id": "svo_chung_toi_doc_sach_en",
          "exercise_type": "mcq_translate_to_en",
          "prompt": {
            "source_text_vi": "Chúng tôi đọc sách",
            "choices_en": ["We read a book", "We eat rice", "He drinks water", "I read a book"],
            "answer_en": "We read a book"
          }
        }
      ]
    }
  ]
}
